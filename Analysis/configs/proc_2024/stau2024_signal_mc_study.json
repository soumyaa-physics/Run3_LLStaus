{
    "year": "2024",
    "file_mode": "local",
    "xrootddomain": "xrootd-cms.infn.it",
    "bad_file_paths": "$CONFDIR/../nano_v11_bad-pnfs-files.json",
    "datadir": "configs/data_UL/2024",
    "store": "/pnfs/desy.de/cms/tier2/store/user/svashish/LLSTauProduction_RUN3/",
    "rng_seed_file": "$CONFDIR/seed.txt",
    "compute_systematics": true,
    "luminosity": 109.82, // fb-1
    "crosssections": "$CONFDIR/../crosssections.json",
    "apply_met_filters": true,
    "dxy_cut_study": false,
    "stau_properties_study": false,
    "mc_lumifactors": "$CONFDIR/lumifactors_stau2018.json",


    "exp_datasets": {
    },

    // Run ranges are only relevant when processing collision data.
    // Kept here for compatibility, but not used by a pure MC sample.
    "data_eras": {
        "2024C": [379412, 380252],
        "2024D": [380253, 380947],
        "2024E-v1": [380948, 381383],
        "2024E-v2": [381384, 381943],
        "2024F": [381944, 383779],
        "2024G": [383780, 385813],
        "2024H": [385814, 386408],
        "2024I-v1": [386409, 386797],
        "2024I-v2": [386798, 387121]
    },

    "pdf_types": {
        "91400": "Hessian",
        "306000": "Hessian",
        "325300": "Hessian",
        "325500": "Hessian",
        "320900": "MC_Gaussian"
    },

    // MC samples used in the study.
    "mc_datasets": {

        // Signal samples
        "SMS-TStauStau_MStau-700_ctau-10mm_mLSP-1": [
            "$STOREDIR/SUS-RunIIISummer2024_EXONANO_stau700_lsp1_ctau10mm_v3/*/*/*/*/*.root"
        ],

        "SMS-TStauStau_MStau-700_ctau-100mm_mLSP-1": [
            "$STOREDIR/SUS-RunIIISummer2024_EXONANO_stau700_lsp1_ctau100mm_v3/*/*/*/*/*.root"
        ],

        "SMS-TStauStau_MStau-700_ctau-1000mm_mLSP-1": [
            "$STOREDIR/SUS-RunIIISummer2024_EXONANO_stau700_lsp1_ctau1000mm_v3/*/*/*/*/*.root"
        ],

        "SMS-TStauStau_MStau-700_ctau-10m_mLSP-1": [
            "$STOREDIR/SUS-RunIIISummer2024_EXONANO_stau700_lsp1_ctau10m_v3/*/*/*/*/*.root"
        ]

    },

    // MC corrections
    "pileup_reweighting": "$DATADIR/pileup.root",

    "DY_ZptLO_weights": [
        "$DATADIR/zptmass_weights_UL2018.root",
        "zptmass_weight",
        ["pt", "mass"]
    ],

    // // Trigger SF is only appropriate if the MC is being corrected
    // // to reproduce the data trigger efficiency.
    // "MET_trigger_sfs": [
    //     "/data/dust/user/sobhatta/work/LongLivedStaus/LLStaus_Run2/Analysis/output/trigger_sf_study/2018/trigger-eff-sfs_MET.root",
    //     "h1_sf",
    //     ["pt"]
    // ],

    "MET_trigger_plateau": 250,

    "DY_jet_reweight": [
        [
            0.0812335727642246,
            0.0176155683054349,
            0.0136231900177429,
            0.0072127496418802,
            0.00786746026143814
        ]
    ],

    "W_jet_reweight": [
        [
            0.747227241113348,
            0.187506782185615,
            0.122313368332312,
            0.0700485945835121,
            0.0612378446670939
        ]
    ],

    // "dataset_for_systematics": {
    // },

    // // No DATA trigger is needed for the MC-only configuration.
    // "dataset_trigger_order": [],

    // "dataset_trigger_map": {
    // },

    // // No data-driven fake-rate prediction in the MC study.
    // "jet_fake_rate": [
    //     "/data/dust/user/mykytaua/nfscms/softLLSTAU/LLStaus_Run2/Analysis/output_iteration_6/2018/output_wjet/wjet_v4_fake_rate_dxy0p2/fake_rate/fake_rate_jet_dxy_pt.root",
    //     "fake_rate_jet_dxy_pt",
    //     ["jet_pt", "jet_dxy"]
    // ],

    "predict_yield": false,

    // Keep if the analysis applies the signal-efficiency uncertainty
    // to the MC signal samples.
    "propagate_eff_factors": true,

    "signal_eff_factors": {
        "central": 1.0,
        "up": 1.15,
        "down": 0.85
    },

    "skim_path": "/afs/desy.de/user/m/mykytaua/nfscms/softLLSTAU/LLStaus_Run2/Analysis/jets_skims",

    "jet_veto_map": [
        "$DATADIR/hotjets-UL18.root",
        "h2hot_ul18_plus_hem1516_and_hbp2m1",
        ["eta", "phi"]
    ],

    // MC jet corrections
    "jet_correction_mc": [
        "$DATADIR/Summer19UL18_V5_MC_L1FastJet_AK4PFchs.txt",
        "$DATADIR/Summer19UL18_V5_MC_L2Relative_AK4PFchs.txt",
        "$DATADIR/Summer19UL18_V5_MC_L3Absolute_AK4PFchs.txt"
    ],

    "jet_uncertainty":
        "$DATADIR/Summer19UL18_V5_MC_Uncertainty_AK4PFchs.txt",

    "jet_resolution":
        "$DATADIR/Summer19UL18_JRV2_MC_PtResolution_AK4PFchs.txt",

    "jet_ressf":
        "$DATADIR/Summer19UL18_JRV2_MC_SF_AK4PFchs.txt",

    "smear_met": false,

    // Global jet selection
    "good_jet_id": "cut:tightlepveto",
    "good_jet_puId": "skip",
    "good_jet_lepton_distance": 0.4,
    "good_jet_eta_min": -2.4,
    "good_jet_eta_max": 2.4,
    "good_jet_pt_min": 20,
    "good_jet_veto_lepton": false,
    "btag": "deepjet:medium",

    // slepton analysis selection

    // muon veto
    "muon_veto_pt_min"   :  20,
    "muon_veto_eta_min"  : -2.4,
    "muon_veto_eta_max"  :  2.4,
    "muon_veto_ID"       :  "looseId",
    "muon_veto_pfIsoId"  :  2, // loose: >= 2

    // ele veto
    "elec_veto_pt"        :  20,
    "elec_veto_eta_min"   : -2.4,
    "elec_veto_eta_max"   :  2.4,
    "elec_veto"           : "convVeto",
    "elec_ID"             : "mvaIso_WPL",
    
    // reco Tau Jet:
    "jet_pt_min"   :  30,
    "jet_eta_min"  : -2.1,
    "jet_eta_max"  :  2.1,
    "jet_jetId"    :  6, // tight lepton veto
    "jet_dxy_min"  :  0.2, // cm
    
    // pfCand selection:
    "pfcand_pt"         : 1.0,
    "pfcand_eta_min"    : -2.4,
    "pfcand_eta_max"    : 2.4,
    "track"             : "hasTrackDetails",

    // MET cut
    "MET_cut"   : 120,
    
    // deltaphi between jets
    "dphi_j1j2" : 0.5, // >=0.5

    // Tagger part
    "score_pass" : [0.05, 0.99],
    "loose_thr" : 0.05,
    "tight_thr" : 0.99,

    "hists": "$CONFDIR/../hists_configs/stau2018_signal_hist_mc.json",

    "cuts_to_histogram": [
        "two_jets_displ",
        "two_jets_loose",
        "exactly_two_jets_loose",
        "dphi_min_cut"
    ]
}